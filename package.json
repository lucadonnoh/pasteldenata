{
  "name": "pastel-de-nata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private agentic payments with 0G confidential inference and mocked English auctions.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "demo": "tsx src/cli.ts",
    "demo:mock": "tsx src/cli.ts --mock",
    "demo:hedera": "tsx src/cli.ts --hedera",
    "demo:hedera:mock": "tsx src/cli.ts --mock --hedera",
    "demo:live": "tsx src/cli.ts --hedera-live",
    "demo:live:mock": "tsx src/cli.ts --mock --hedera-live",
    "demo:market": "tsx src/cli.ts --market",
    "demo:market:mock": "tsx src/cli.ts --mock --market",
    "demo:hedera:simple": "tsx src/cli.ts --mock --hedera-simple",
    "hedera:setup": "tsx src/hedera/setup.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run lint",
    "demo:scalper": "tsx src/server/scalper-demo.ts"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.81.0",
    "@noble/hashes": "^2.2.0",
    "@worldcoin/agentkit": "^0.2.0",
    "@worldcoin/idkit-core": "^2.1.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@worldcoin/agentkit-cli": "^0.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "protobufjs": "^8.0.1",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22"
  }
