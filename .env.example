# Used by the local CLI. It is also read server-side when the explicit hosted
# demo switches below are enabled; it is never a NEXT_PUBLIC browser variable.
ZEROG_KEY=sk-replace-me

# Optional CLI overrides
ZEROG_MODEL=0gm-1.0-35b-a3b
ZEROG_BASE_URL=https://router-api.0g.ai/v1

# Hedera testnet operator for --hedera settlement.
# Create a free account at https://portal.hedera.com
HEDERA_OPERATOR_ID=0.0.replace-me
HEDERA_OPERATOR_KEY=replace-me
# Bare 64-character keys default to ECDSA. Set only for a raw ED25519 key:
# HEDERA_OPERATOR_KEY_TYPE=ED25519

# Hosted hackathon demo. This removes the browser key field and proxies private
# planning through the deployment, so the hosting service sees plaintext
# intents before forwarding them to 0G. Keep the Railway URL unadvertised and
# set conservative shared-key/testnet abuse budgets.
# HOSTED_DEMO_MODE=true
# ZEROG_SERVER_DEMO=true
# WORLD_DEMO_PRIVATE_KEY=0x-replace-with-a-32-byte-evm-key
# DEMO_MAX_RUNS_PER_IP_PER_HOUR=10
# DEMO_MAX_RUNS_PER_HOUR=30
#
# The settlement coordinator is localhost-only unless explicitly enabled.
# HEDERA_ALLOW_REMOTE=false

# Railway attaches a volume and provides RAILWAY_VOLUME_MOUNT_PATH
# automatically. For another host, set this to a persistent directory.
# PASTEL_DATA_DIR=/data
